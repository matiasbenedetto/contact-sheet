{
  "name": "contact-sheet",
  "version": "1.2.2",
  "description": "Contact Sheet \u2014 WordPress block theme",
  "private": true,
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=blocks/photo-strip/src --output-path=blocks/photo-strip/build",
    "start": "wp-scripts start --webpack-src-dir=blocks/photo-strip/src --output-path=blocks/photo-strip/build",
    "package": "bash scripts/package.sh",
    "deploy": "bash scripts/deploy.sh",
    "release": "bash scripts/release.sh",
    "lint:js": "wp-scripts lint-js blocks/photo-strip/src",
    "lint:css": "wp-scripts lint-style blocks/photo-strip/src"
  },
  "devDependencies": {
    "@wordpress/scripts": "^30.0.0"
  }
}
