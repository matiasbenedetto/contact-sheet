# Files & directories excluded from the WordPress.org deploy.
# Everything listed here is dev-only; the built `blocks/photo-strip/build/`
# directory is committed and IS shipped.

# Secrets / environment (never ship)
.env
.env.*

# Dev tooling / VCS
/.git
/.github
/.claude
/.codex
/node_modules
/scripts
/dist
/playground
/workdir
/demo-site
/social

# Block sources (only the compiled build/ is shipped)
/blocks/photo-strip/src

# Project meta
/package.json
/package-lock.json
/.gitignore
/.distignore
contact-sheet.zip

# Docs & README assets (the root screenshot.jpg IS shipped; the
# screenshots/ folder only feeds the README and is dev-only)
/README.md
/AGENTS.md
/AGENTS.local.md
/CLAUDE.md
/screenshots

# OS / editor cruft
.DS_Store
Thumbs.db
*.log
*.mjs
