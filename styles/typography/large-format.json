{
	"$schema": "https://schemas.wp.org/wp/6.8/theme.json",
	"version": 3,
	"title": "Large Format",
	"settings": {
		"typography": {
			"fontFamilies": [
				{
					"fontFamily": "Fraunces, Georgia, serif",
					"name": "Fraunces",
					"slug": "fraunces",
					"fontFace": [
						{
							"fontFamily": "Fraunces",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/large-format/Fraunces.woff2"
							]
						}
					]
				},
				{
					"fontFamily": "\"Work Sans\", system-ui, sans-serif",
					"name": "Work Sans",
					"slug": "work-sans",
					"fontFace": [
						{
							"fontFamily": "Work Sans",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/large-format/WorkSans.woff2"
							]
						},
						{
							"fontFamily": "Work Sans",
							"fontStyle": "italic",
							"fontWeight": "100 900",
							"src": [
								"file:./assets/fonts/large-format/WorkSans-Italic.woff2"
							]
						}
					]
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--work-sans)"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--fraunces)",
					"fontWeight": "380"
				}
			}
		},
		"blocks": {
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--work-sans)"
				}
			},
			"core/post-template": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--work-sans)"
				}
			}
		}
	}
}
